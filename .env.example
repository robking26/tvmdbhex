# TMDB credentials (only the ingester needs these; the API never calls TMDB).
# Use either a v4 "API Read Access Token" or a v3 API key.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Database shared by the ingester and the API: Postgres if DATABASE_URL is set
# (e.g. on Vercel), otherwise the SQLite file.
DATABASE_URL=
TVMDBHEX_DB_PATH=data/tvmdbhex.db

# Comma-separated keys that clients (e.g. Hoozat) must send as `X-API-Key`.
# Leave empty to disable auth (local development only).
TVMDBHEX_API_KEYS=

# Ingestion tuning.
TVMDBHEX_CONCURRENCY=16
TVMDBHEX_REQUESTS_PER_SECOND=40
TVMDBHEX_POSTER_SIZE=w185
TVMDBHEX_INCLUDE_ADULT=false

# Palette tuning tools: /debug page and /v1/debug/* endpoints. Leave off in production.
TVMDBHEX_DEBUG=false
